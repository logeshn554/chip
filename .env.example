# ─────────────────────────────────────────────
# Environment Variables for Self-Evolving Chip Agent
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.

# ── LLM ──────────────────────────────────────
# HuggingFace token (for gated model downloads)
HF_TOKEN=

# vLLM server URL (if using vLLM backend)
VLLM_BASE_URL=http://localhost:8000/v1

# ── Web Search ───────────────────────────────
# Serper API key (optional, for Google search)
SERPER_API_KEY=

# Tavily API key (optional, for Tavily search)
TAVILY_API_KEY=

# ── Paths ────────────────────────────────────
# Override default paths
# DESIGNS_DIR=./designs
# TRAJECTORIES_DIR=./trajectories
# CHROMA_DB_PATH=./data/chroma
