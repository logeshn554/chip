{# Jinja2 template: Parameterized ALU module #}
`timescale 1ns / 1ps

module {{ name | default("alu") }} #(
    parameter DATA_WIDTH = {{ data_width | default(8) }}
)(
    input  logic                    clk,
    input  logic                    rst_n,
    input  logic [DATA_WIDTH-1:0]   operand_a,
    input  logic [DATA_WIDTH-1:0]   operand_b,
    input  logic [3:0]              operation,
    output logic [DATA_WIDTH-1:0]   result,
    output logic                    zero_flag,
    output logic                    carry_flag,
    output logic                    overflow_flag
);

    // Operation codes
    localparam OP_ADD  = 4'b0000;
    localparam OP_SUB  = 4'b0001;
    localparam OP_AND  = 4'b0010;
    localparam OP_OR   = 4'b0011;
    localparam OP_XOR  = 4'b0100;
    localparam OP_SLL  = 4'b0101;  // Shift left logical
    localparam OP_SRL  = 4'b0110;  // Shift right logical
    localparam OP_SRA  = 4'b0111;  // Shift right arithmetic
    localparam OP_SLT  = 4'b1000;  // Set less than
    localparam OP_SLTU = 4'b1001;  // Set less than unsigned
    localparam OP_NOT  = 4'b1010;
    localparam OP_NAND = 4'b1011;
    localparam OP_NOR  = 4'b1100;

    logic [DATA_WIDTH:0] temp_result;  // Extra bit for carry

    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            result        <= '0;
            zero_flag     <= 1'b0;
            carry_flag    <= 1'b0;
            overflow_flag <= 1'b0;
        end else begin
            case (operation)
                OP_ADD:  temp_result = {1'b0, operand_a} + {1'b0, operand_b};
                OP_SUB:  temp_result = {1'b0, operand_a} - {1'b0, operand_b};
                OP_AND:  temp_result = {1'b0, operand_a & operand_b};
                OP_OR:   temp_result = {1'b0, operand_a | operand_b};
                OP_XOR:  temp_result = {1'b0, operand_a ^ operand_b};
                OP_SLL:  temp_result = {1'b0, operand_a << operand_b[$clog2(DATA_WIDTH)-1:0]};
                OP_SRL:  temp_result = {1'b0, operand_a >> operand_b[$clog2(DATA_WIDTH)-1:0]};
                OP_SRA:  temp_result = {1'b0, $signed(operand_a) >>> operand_b[$clog2(DATA_WIDTH)-1:0]};
                OP_SLT:  temp_result = {1'b0, {(DATA_WIDTH-1){1'b0}}, $signed(operand_a) < $signed(operand_b)};
                OP_SLTU: temp_result = {1'b0, {(DATA_WIDTH-1){1'b0}}, operand_a < operand_b};
                OP_NOT:  temp_result = {1'b0, ~operand_a};
                OP_NAND: temp_result = {1'b0, ~(operand_a & operand_b)};
                OP_NOR:  temp_result = {1'b0, ~(operand_a | operand_b)};
                default: temp_result = '0;
            endcase

            result     <= temp_result[DATA_WIDTH-1:0];
            carry_flag <= temp_result[DATA_WIDTH];
            zero_flag  <= (temp_result[DATA_WIDTH-1:0] == '0);

            // Overflow: sign of result differs from expected
            overflow_flag <= (operation == OP_ADD || operation == OP_SUB) &&
                           (operand_a[DATA_WIDTH-1] ^ temp_result[DATA_WIDTH-1]) &&
                           !(operand_a[DATA_WIDTH-1] ^ operand_b[DATA_WIDTH-1] ^ (operation == OP_SUB));
        end
    end

endmodule
